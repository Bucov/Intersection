HOST=127.0.0.1
PORT=3001

# Proposal mode and independently selected arbitration mode. No keys needed for mock.
DEMO_MODE=mock
JEV_MODE=mock
JEV_MOCK_FIXTURE=agent-a

# Each live agent needs an explicitly selected model supported by Mozaik 4.1.0.
# Run npm run models -w @intersection/server to inspect the installed registry.
AGENT_A_PROVIDER=claude
AGENT_A_MODEL=claude-haiku-4-5
AGENT_B_PROVIDER=gemini
AGENT_B_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# Only live JEV needs this key. The adapter owns the TypeSafe client.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=

# Optional: stream every agent loop to the Mozaik cloud dashboard (app.jigjoy.ai).
# Off unless set to "on". Authenticate once with `npx @mozaik-ai/cloud-sdk pair`
# (saves ~/.mozaik/credentials.json) or paste the project key below.
MOZAIK_CLOUD=off
# MOZAIK_API_KEY=pk_...
# none (default) | content | all — what prompt/answer content is uploaded.
# MOZAIK_REDACTION=content
