{
  "name": "@intersection/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @intersection/shared && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "models": "node scripts/models.mjs",
    "test:live": "node --import tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@google/genai": "^2.32.0",
    "@intersection/shared": "*",
    "@mozaik-ai/cloud-sdk": "^0.1.3",
    "@mozaik-ai/core": "4.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "mozaik-jev-adapter": "file:../../vendor/mozaik-jev-adapter-0.1.0-3f4cf7b.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
